---
import Layout from "../../layouts/Layout.astro";
import populationMain from "../../assets/populationMain.json";

const listePeriode = [
  ...new Set(populationMain.map((population) => population.Période)),
].reverse();
const listeSexe = [...new Set(populationMain.map((population) => population.Sexe))];
const listeAge = [
  "Total",
  ...new Set(
    populationMain
      .map((population) => population["Âge"])
      .filter((age) => age !== "Total"),
  ),
];
---
<Layout>
  <section class="content-container">
    <div class="page-heading">
      <div>
        <p class="eyebrow">DONNÉES DE POPULATION</p>
        <h1>Population par département</h1>
        <p class="intro">
          Explorez la répartition de la population française selon l'année,
          le sexe et la tranche d'âge.
        </p>
      </div>
      <span class="data-badge">France métropolitaine</span>
    </div>

    <section class="map-card">
      <div class="card-heading">
        <div>
          <h2>Carte interactive</h2>
          <p>Utilisez les filtres pour comparer les territoires.</p>
        </div>
        <span class="hint">Survolez un département</span>
      </div>

      <form id="population-filters" class="filters">
    <label>
      Année
      <select id="periode">
        {listePeriode.map((periode, index) => (
          <option value={periode} selected={index === 0}>{periode}</option>
        ))}
      </select>
    </label>

    <label>
      Sexe
      <select id="sexe">
        {listeSexe.map((sexe, index) => (
          <option value={sexe} selected={index === 0}>{sexe}</option>
        ))}
      </select>
    </label>

    <label>
      Âge
      <select id="age">
        {listeAge.map((age, index) => (
          <option value={age} selected={index === 0}>{age}</option>
        ))}
      </select>
    </label>

      </form>

      <div id="population-map" aria-label="Carte de la population par département"></div>
    </section>
  </section>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import departements from "../../assets/departements.geojson.json";
  import populationMain from "../../assets/populationMain.json";

  type Population = (typeof populationMain)[number];

  const elmYear = document.getElementById("periode") as HTMLSelectElement;
  const elmSex = document.getElementById("sexe") as HTMLSelectElement;
  const elmAge = document.getElementById("age") as HTMLSelectElement;
  const map = document.querySelector<HTMLDivElement>("#population-map");

  if (!elmYear || !elmSex || !elmAge || !map) {
    throw new Error("Les éléments de la carte de population sont introuvables.");
  }

  let selectedYear = Number(elmYear.value);
  let selectedSex = elmSex.value;
  let selectedAge = elmAge.value;

  const findPopulation = (
    feature: (typeof departements.features)[number],
  ): Population | undefined => {
    const department = feature.properties.nom;
    return populationMain.find(
      (population) =>
        population.Géographie === department &&
        population.Période === selectedYear &&
        population.Sexe === selectedSex &&
        population["Âge"] === selectedAge,
    );
  };

  const renderMap = () => {
    const plot = Plot.plot({
      title: "Population par département",
      subtitle: `Année ${selectedYear} · Sexe : ${selectedSex} · Âge : ${selectedAge}`,
      caption:
        "Les couleurs représentent la population en centaines de milliers. Survolez un département pour consulter sa valeur.",
      ariaLabel: `Carte de la population des départements français pour ${selectedYear}, ${selectedSex}, ${selectedAge}.`,
      projection: {
        type: "mercator",
        domain: departements,
      },
      color: {
        type: "quantile",
        n: 8,
        scheme: "Greens",
        label: "Population (centaines de milliers)",
        legend: true,
        tickFormat: (value: number) => Math.round(value / 100000),
      },
      marks: [
        Plot.geo(departements, {
          fill: (feature) => findPopulation(feature)?.Valeur ?? null,
          stroke: "#999",
          title: (feature) => {
            const population = findPopulation(feature);
            return `${feature.properties.nom} : ${population?.Valeur ?? "Donnée indisponible"}`;
          },
          tip: true,
        }),
      ],
    });

    map.replaceChildren(plot);
  };

  const updateMap = () => {
    selectedYear = Number(elmYear.value);
    selectedSex = elmSex.value;
    selectedAge = elmAge.value;
    renderMap();
  };

  elmYear.addEventListener("change", updateMap);
  elmSex.addEventListener("change", updateMap);
  elmAge.addEventListener("change", updateMap);
  renderMap();
</script>

<style>
  main {
  }

  .content-container {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.5rem 0;
  }

  .page-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: #087443;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h1,
  h2 {
    margin: 0;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .intro {
    max-width: 620px;
    margin: 0.8rem 0 0;
    color: #678073;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .data-badge,
  .hint {
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    background: #e6f3eb;
    color: #087443;
    font-size: 0.75rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .map-card {
    overflow: hidden;
    border: 1px solid #dce7df;
    border-radius: 1.25rem;
    background: white;
    box-shadow: 0 16px 40px rgba(20, 71, 47, 0.08);
  }

  .card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem 1.25rem;
    border-bottom: 1px solid #edf2ee;
  }

  h2 {
    font-size: 1.3rem;
  }

  .card-heading p {
    margin: 0.35rem 0 0;
    color: #789083;
    font-size: 0.85rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 1.75rem;
    background: #fbfdfb;
    border-bottom: 1px solid #edf2ee;
  }

  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: #547064;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .filters select {
    min-width: 12rem;
    padding: 0.4rem;
    border: 1px solid #cbdacf;
    border-radius: 0.5rem;
    background: white;
    color: #17352b;
    font: inherit;
  }

  #population-map {
    min-height: 34rem;
    padding: 1rem;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .content-container {
      padding: 2rem 0;
    }

    .page-heading,
    .card-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .data-badge,
    .hint {
      white-space: normal;
    }

    .filters {
      flex-direction: column;
    }

    .filters select {
      width: 100%;
    }
  }
</style>
