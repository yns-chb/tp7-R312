---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../components/PlotFigure.astro";
import penguins from "../assets/penguins.json";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="home-container">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">OBSERVATOIRE DES TERRITOIRES</p>
        <h1>Comprendre les territoires grâce aux données.</h1>
        <p class="hero-text">
          Explorez des informations claires et accessibles sur la population
          et les établissements présents en France.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="/Populations/Carte">
            Explorer les populations <span aria-hidden="true">→</span>
          </a>
          <a class="secondary-action" href="/etablissements">
            Voir les établissements
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <span class="visual-dot dot-one"></span>
        <span class="visual-dot dot-two"></span>
        <span class="visual-dot dot-three"></span>
        <span class="visual-line line-one"></span>
        <span class="visual-line line-two"></span>
        <div class="visual-card">
          <span class="visual-label">DONNÉES TERRITORIALES</span>
          <strong>France</strong>
          <div class="visual-bars">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
          <small>Une lecture simple, des données utiles.</small>
        </div>
      </div>
    </section>

    <section class="discover">
      <div class="section-heading">
        <div>
          <p class="eyebrow">À DÉCOUVRIR</p>
          <h2>Deux façons d'explorer</h2>
        </div>
        <p>Accédez rapidement aux visualisations disponibles.</p>
      </div>

      <div class="feature-grid">
        <a class="feature-card population-card" href="/Populations/Carte">
          <span class="feature-icon">◒</span>
          <div>
            <p class="feature-kicker">01 · ANALYSE</p>
            <h3>Population</h3>
            <p>
              Comparez les effectifs par département selon l'année, le sexe et
              l'âge.
            </p>
          </div>
          <span class="feature-link">Ouvrir la carte <span>↗</span></span>
        </a>

        <a class="feature-card places-card" href="/etablissements">
          <span class="feature-icon">⌖</span>
          <div>
            <p class="feature-kicker">02 · LOCALISATION</p>
            <h3>Établissements</h3>
            <p>
              Repérez les établissements sur une carte interactive et
              consultez leurs informations.
            </p>
          </div>
          <span class="feature-link">Ouvrir la carte <span>↗</span></span>
        </a>
      </div>
    </section>

    <section class="chart-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXEMPLE DE VISUALISATION</p>
          <h2>Graphique exploratoire</h2>
        </div>
        <p>Le graphique Observable Plot présent sur la page d'accueil.</p>
      </div>

      <div class="chart-card">
        <PlotFigure
          options={{
            marks: [
              Plot.dot(penguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
              }),
            ],
          }}
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  .home-container {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
    min-height: 430px;
    padding: clamp(2rem, 5vw, 4.5rem);
    overflow: hidden;
    border-radius: 1.5rem;
    background: linear-gradient(125deg, #0b6c40, #124d37);
    color: white;
    box-shadow: 0 24px 50px rgba(20, 71, 47, 0.18);
  }

  .hero::before,
  .hero::after {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 50%;
    content: "";
  }

  .hero::before {
    width: 520px;
    height: 520px;
    right: -170px;
    top: -220px;
  }

  .hero::after {
    width: 370px;
    height: 370px;
    right: -40px;
    bottom: -240px;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero .eyebrow {
    color: #a9e6c0;
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: #087443;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    letter-spacing: -0.045em;
  }

  h1 {
    max-width: 620px;
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    line-height: 1.03;
  }

  .hero-text {
    max-width: 540px;
    margin: 1.25rem 0 0;
    color: #d3f0dc;
    font-size: 1.1rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .primary-action,
  .secondary-action {
    padding: 0.8rem 1rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
  }

  .primary-action {
    background: white;
    color: #0b6c40;
  }

  .secondary-action {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
  }

  .hero-visual {
    position: relative;
    min-height: 300px;
  }

  .visual-card {
    position: absolute;
    z-index: 1;
    right: 8%;
    top: 13%;
    width: min(290px, 80%);
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.13);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
  }

  .visual-label,
  .visual-card small {
    display: block;
    color: #a9e6c0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .visual-card strong {
    display: block;
    margin-top: 1.8rem;
    font-size: 2rem;
  }

  .visual-card small {
    margin-top: 1.4rem;
    color: #d3f0dc;
    letter-spacing: normal;
  }

  .visual-bars {
    display: flex;
    align-items: end;
    gap: 0.45rem;
    height: 75px;
    margin-top: 1rem;
  }

  .visual-bars span {
    display: block;
    width: 18%;
    border-radius: 0.25rem 0.25rem 0 0;
    background: #a9e6c0;
  }

  .visual-bars span:nth-child(1) { height: 35%; }
  .visual-bars span:nth-child(2) { height: 55%; }
  .visual-bars span:nth-child(3) { height: 45%; }
  .visual-bars span:nth-child(4) { height: 78%; }
  .visual-bars span:nth-child(5) { height: 95%; }

  .visual-dot,
  .visual-line {
    position: absolute;
    display: block;
  }

  .visual-dot {
    width: 0.75rem;
    height: 0.75rem;
    border: 3px solid #a9e6c0;
    border-radius: 50%;
  }

  .dot-one { right: 12%; top: 4%; }
  .dot-two { right: 4%; bottom: 21%; }
  .dot-three { left: 8%; bottom: 10%; }

  .visual-line {
    width: 120px;
    height: 1px;
    background: rgba(169, 230, 192, 0.55);
    transform: rotate(-28deg);
  }

  .line-one { right: 4%; top: 19%; }
  .line-two { left: 4%; bottom: 25%; transform: rotate(24deg); }

  .discover {
    padding-top: 4.5rem;
  }

  .chart-section {
    padding-top: 4.5rem;
  }

  .chart-card {
    overflow-x: auto;
    padding: 1.5rem;
    border: 1px solid #dce7df;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 12px 30px rgba(20, 71, 47, 0.06);
  }

  .chart-card :global(figure) {
    margin: 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .section-heading p:last-child {
    margin: 0;
    color: #789083;
    font-size: 0.9rem;
  }

  h2 {
    font-size: 2rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    min-height: 260px;
    padding: 1.6rem;
    border: 1px solid #dce7df;
    border-radius: 1rem;
    color: #17352b;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(20, 71, 47, 0.1);
  }

  .population-card { background: #e6f3eb; }
  .places-card { background: #fff; }

  .feature-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 2rem;
    place-items: center;
    border-radius: 0.7rem;
    background: #087443;
    color: white;
    font-size: 1.35rem;
  }

  .feature-kicker {
    margin: 0 0 0.5rem;
    color: #087443;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h3 {
    font-size: 1.55rem;
  }

  .feature-card p:not(.feature-kicker) {
    max-width: 390px;
    margin: 0.65rem 0 0;
    color: #678073;
    line-height: 1.55;
  }

  .feature-link {
    display: block;
    margin-top: auto;
    padding-top: 1.5rem;
    color: #087443;
    font-size: 0.85rem;
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      min-height: 230px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .home-container {
      padding-top: 2rem;
    }

    .hero {
      padding: 2rem 1.5rem;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
