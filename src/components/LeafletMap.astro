---
import "leaflet/dist/leaflet.css";
---

<div id="map" class="leaflet-map" aria-label="Carte des établissements"></div>

<script>
  import listeEtablissements from "../assets/listeEtablissements.json";
  import L from "leaflet";

  // Ce script est exécuté côté client par Astro après son chargement dans le navigateur.
  const mapElement = document.querySelector("#map");

  if (!mapElement) {
    throw new Error("Le conteneur Leaflet #map est introuvable.");
  }

  const map = L.map(mapElement).setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  for (const etablissement of listeEtablissements) {
    L.marker([etablissement.lat, etablissement.lon])
      .addTo(map)
      .bindPopup(etablissement.name);
  }

  requestAnimationFrame(() => map.invalidateSize());
</script>

<style>
  .leaflet-map {
    width: 100%;
    height: 600px;
    min-height: 400px;
    z-index: 0;
  }
</style>
